{
  "name": "vans-classroom-install",
  "displayName": "凡思課堂安裝",
  "description": "課堂側邊欄：檢查／安裝環境工具，並一鍵執行本課安裝動作。",
  "version": "0.0.1",
  "publisher": "vans-coding",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:vansClassroomInstall.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vansClassroomInstall.runInstallAction",
        "title": "執行本課安裝動作"
      },
      {
        "command": "vansClassroomInstall.recheckEnvironment",
        "title": "重新檢查環境工具"
      },
      {
        "command": "vansClassroomInstall.installEnvironmentTool",
        "title": "安裝／修復環境工具"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vansClassroomInstall",
          "title": "凡思課堂安裝",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vansClassroomInstall": [
        {
          "type": "webview",
          "id": "vansClassroomInstall.sidebar",
          "name": "凡思課堂安裝"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/**/*.test.js",
    "typecheck": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository --skip-license --readme-path EXTENSION_README.md"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
